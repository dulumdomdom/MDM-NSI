{
  "name": "mdm-nsi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MDM-система НСИ: конфигурируемые справочники и классификаторы (SPA, Vue 3)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "ci": "npm run lint && npm run type-check && npm run test:unit && npm run build:only",
    "bundle:offline": "npm run build && node scripts/bundle-offline.mjs",
    "smoke:offline": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 node scripts/smoke-offline.mjs",
    "prepare": "husky || true"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,vue,js}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@primeuix/themes": "1.2.5",
    "axios": "1.16.1",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/tsconfig": "0.7.0",
    "autoprefixer": "10.5.0",
    "cross-env": "7.0.3",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "msw": "2.10.5",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.48.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "2.2.12"
  }
}
